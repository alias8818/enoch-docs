{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "willow",
  "name": "Enoch Docs",
  "description": "Documentation website for learning, deploying, and reviewing the Enoch agentic research control plane and generated-artifact corpus.",
  "colors": {
    "primary": "#cc785c",
    "light": "#f2b29a",
    "dark": "#a9583e"
  },
  "favicon": "favicon.ico",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant"
    ]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Docs source",
          "icon": "github",
          "href": "https://github.com/alias8818/enoch-docs"
        },
        {
          "anchor": "System repo",
          "icon": "code",
          "href": "https://github.com/alias8818/enoch-agentic-research-system"
        },
        {
          "anchor": "Corpus",
          "icon": "database",
          "href": "https://github.com/alias8818/enoch-ai-research-corpus"
        },
        {
          "anchor": "Promising signals",
          "icon": "sparkles",
          "href": "https://github.com/alias8818/enoch-promising-signals"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "current-runtime-snapshot",
              "quickstart",
              "deployment"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/control-plane",
              "concepts/worker-gate",
              "concepts/evidence-and-artifacts"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/idea-intake",
              "guides/dispatch-flow",
              "guides/paper-artifacts",
              "guides/alerts"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "configuration/overview",
              "configuration/worker",
              "configuration/paper-writer"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "release-notes",
              "reference/api-endpoints",
              "reference/authorship-provenance",
              "reference/promising-signals",
              "reference/troubleshooting"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "System repo",
        "href": "https://github.com/alias8818/enoch-agentic-research-system"
      },
      {
        "label": "Corpus",
        "href": "https://github.com/alias8818/enoch-ai-research-corpus"
      },
      {
        "label": "Promising signals",
        "href": "https://github.com/alias8818/enoch-promising-signals"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/alias8818/enoch-docs"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/alias8818/enoch-docs"
    }
  }
}
