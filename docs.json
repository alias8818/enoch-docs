{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "willow",
  "name": "Enoch Docs",
  "description": "Source-grounded documentation for the Enoch agentic research control plane and AI-generated research artifact corpus.",
  "colors": {
    "primary": "#848c8e",
    "light": "#11161e",
    "dark": "#cfd0d2"
  },
  "favicon": "favicon.ico",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant"
    ]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/alias8818/enoch-agentic-research-system"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "deployment"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/control-plane",
              "concepts/wake-gate",
              "concepts/evidence-and-artifacts"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/idea-intake",
              "guides/dispatch-flow",
              "guides/paper-artifacts",
              "guides/alerts"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "configuration/overview",
              "configuration/worker",
              "configuration/paper-writer"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/api-endpoints",
              "reference/authorship-provenance",
              "reference/troubleshooting",
              "reference/screenshots-needed"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "github",
      "href": "https://github.com/alias8818/enoch-agentic-research-system"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/alias8818/enoch-agentic-research-system"
    }
  }
}
